# Template for local env — copy to .env and fill in real values.
# Committed to VCS; never put real secrets here.

# Base URL of the backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only secrets (not exposed to the browser)
# API_SECRET=
# DATABASE_URL=

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# 구글 서치 콘솔 소유권 확인(HTML 태그 방식)의 content 값 - 선택
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 사이트 대표 주소(기본: https://gaemigul-app.vercel.app) - 도메인을 바꾸면 설정
# NEXT_PUBLIC_SITE_URL=
